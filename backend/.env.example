# General
NODE_ENV=development
PORT=4000
# The deployed frontend origin(s) allowed to call this API, comma separated.
WEB_URL=http://localhost:5173
# The public URL of THIS API (used to build links to uploaded posters).
API_URL=http://localhost:4000
LOG_LEVEL=info

# Database: sqlite3 for local work and tests, pg for production (Neon, Supabase, RDS...)
DATABASE_CLIENT=sqlite3
SQLITE_FILE=./data/dev.sqlite
# DATABASE_CLIENT=pg
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth. JWT_SECRET must be a long random string (32+ characters) in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=2h
REFRESH_TTL_DAYS=0.0833333
# lax when site and API share a domain; none (HTTPS only) when they are on different domains. Defaults: lax in development, none in production.
# COOKIE_SAMESITE=none
AUTO_VERIFY_EMAIL=true
ALLOWED_EMAIL_DOMAINS=campus.example

# Mail (development prints to the console when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GENESIS Campus Connect <no-reply@campus.example>"

# Chat assistant: server side only, never exposed to the browser. Without a key the chat answers with built-in rules.
# Pick one. Groq (free tier available) uses llama-3.3-70b-versatile by default; Claude uses claude-opus-5-5.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override for whichever provider is used.
LLM_MODEL=
CHAT_TIMEOUT_MS=20000
CHAT_RATE_PER_MINUTE=20

# Demo sign-ins (STU2026001, CLUB001, CLUB002, OSA001, EVT001). Ignored in production.
SEED_DEMO_PORTAL=true
